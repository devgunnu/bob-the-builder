# Bob the Builder: every config var (CONTRACTS section 9) with its default. Copy to .env. Never commit .env.
# Owner: A1. Values in <> are filled after A5 deploys BobData.

# ---------- Bob's own AWS (hosting); Bedrock uses it only when BOB_BEDROCK_AUTH=default ----------
AWS_REGION=us-east-1
AWS_PROFILE=
# or AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=

# ---------- model defaults for new profiles (D33); format <provider>:<model_id> ----------
# A1 confirms the exact ids at the first Bedrock call.
BOB_DEFAULT_WRITER_MODEL=bedrock:global.anthropic.claude-haiku-5-5
BOB_DEFAULT_PLANNER_MODEL=bedrock:global.anthropic.claude-sonnet-5-5
BOB_DEFAULT_JUDGE_MODEL=bedrock:global.anthropic.claude-sonnet-5-5
# empty = the writer model
BOB_DEFAULT_FALLBACK_MODEL=
BOB_MODEL_REGISTRY=bob/llm/registry.json
# aws only: KMS key that encrypts user API keys (P1)
BOB_KMS_KEY_ID=

# ---------- provider keys ----------
# Jev: direct Jev API with a Jev API console key (D34). A2 confirms JEV_BASE_URL at the first real call.
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=typesafe/jev-1.13-20260917
SCALEDOWN_API_KEY=
SCALEDOWN_BASE_URL=https://api.scaledown.xyz
# optional: only for ScaleDown via OpenRouter; Jev does not use it
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
COMPOSIO_API_KEY=
# Composio user_id = COMPOSIO_USER_PREFIX + UserProfile.id
COMPOSIO_USER_PREFIX=bob-
# pre-connected demo accounts, comma-separated, e.g. notion:<connected_account_id>
COMPOSIO_DEMO_ACCOUNTS=

# ---------- service prices (USD per M input tokens); LLM prices come from the model registry ----------
JEV_PRICE_IN_PER_M=0.042
SCALEDOWN_PRICE_IN_PER_M=0.04

# ---------- generation, verification, concurrency (* = a job can override it with JobSpec.options) ----------
KEEP_P=0.9
REJECT_P=0.3
AUDIT_RATE=0.02
DEDUP_COS=0.92
OVERGEN=1.6
MAX_ROUNDS=3
WRITER_BATCH=5
WRITER_CONCURRENCY=16
JEV_CONCURRENCY=32
SCALEDOWN_CONCURRENCY=16
JUDGE_CONCURRENCY=4
# 0 turns the real-response cache off
BOB_CACHE=1

# ---------- verification and data (section 4) ----------
EXTRACT_NAMES_CASE_TYPES=answerable,partial,unanswerable,false_premise
EXTRACT_EXEMPT_ABSENT=true
ABSENT_MATCH=85
# all | false_premise | none
NUMBERS_ALLOW_USER=all
# synthesize | pair | off
DPO_MODE=synthesize
DPO_RATE=0.3
CELL_AXES=topic,case_type
MAX_CELLS=120
MAX_TOPICS=20
MIN_CELL_TARGET=3
CASE_MIX=answerable:0.5,partial:0.15,unanswerable:0.2,false_premise:0.15

# ---------- accounts and BYO AWS (section 14) ----------
# none | cognito (the aws deploy sets cognito)
BOB_AUTH=none
BOB_COGNITO_REGION=
BOB_COGNITO_USER_POOL_ID=
BOB_COGNITO_CLIENT_ID=
BOB_COGNITO_DOMAIN=
# open | invite
BOB_SIGNUP=invite
# default | assume_role (the aws deploy sets assume_role)
BOB_BEDROCK_AUTH=default
# Bob's hosting AWS account id, shown on the Account screen
BOB_ACCOUNT_ID=
BOB_CRED_REFRESH_S=300
BOB_BEDROCK_DEFAULT_REGION=us-east-1
BOB_MAX_ACTIVE_JOBS_PER_USER=1
BOB_HEARTBEAT_S=10
BOB_HEARTBEAT_TIMEOUT_S=90
BOB_OAUTH_CALLBACK_PATH=/oauth/callback

# ---------- deployment (D25) ----------
# local | aws
BOB_ENV=local
# aws: /tmp/runs
BOB_RUNS_DIR=runs
BOB_TABLE=bob
BOB_BUCKET=<data bucket>
BOB_SECRET_ARN=<arn of bob/keys>
BOB_ECS_CLUSTER=
BOB_TASK_DEF=
# comma list
BOB_SUBNETS=
BOB_SECURITY_GROUP=
BOB_CONTAINER_NAME=worker
BOB_MAX_WORKERS=2
BOB_CONTROL_POLL_S=1
BOB_APPROVAL_WAIT_MINUTES=60
BOB_EVENT_POLL_MS=500
BOB_SSE_HEARTBEAT_S=15
BOB_SSE_MAX_S=840
BOB_PUBLIC_URL=<CloudFront URL>
# baked into the image; empty in local mode = model2vec download
BOB_EMBED_MODEL_PATH=
# Lambda only (set by CDK): AWS_LWA_INVOKE_MODE=response_stream, AWS_LWA_PORT=8080, AWS_LWA_READINESS_CHECK_PATH=/api/ping
